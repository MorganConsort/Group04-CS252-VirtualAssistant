# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=fake          # fake | gemini
LLM_API_KEY=
LLM_MODEL=                 # empty = gemini-3.8-flash
# Copy this file to `.env` for local development. Never commit `.env`.
# `.env` is ignored by git; this example contains no real secrets.
DATABASE_URL=sqlite:///./local.db

# Staging/production (PostgreSQL 16) uses the same variable, for example:
# DATABASE_URL=postgresql+psycopg://user:placeholder@localhost:5432/study_companion

# Optional scheduling Workspace uses an isolated database and companion settings.
PATHLY_DATABASE_URL=sqlite:///./pathly.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_HOURS=24
COMPANION_LLM_BASE_URL=https://api.openai.com/v1
COMPANION_LLM_API_KEY=
COMPANION_LLM_MODEL=
COMPANION_LLM_TIMEOUT_SECONDS=20
