# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=fake          # fake | gemini
LLM_API_KEY=
LLM_MODEL=                 # concepts; comma list tried in order; empty = gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_VISION_MODEL=          # reads PDF pages (diagrams, scans); empty = gemini-3.1-flash-lite
# Copy this file to `.env` for local development. Never commit `.env`.
# `.env` is ignored by git; this example contains no real secrets.
DATABASE_URL=sqlite:///./local.db

# Staging/production (PostgreSQL 16) uses the same variable, for example:
# DATABASE_URL=postgresql+psycopg://user:placeholder@localhost:5432/study_companion

# Backend API (src/assistant/backend) uses DATABASE_URL above and applies the
# Alembic migrations at startup. Bearer sessions are server-side and revocable.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_MINUTES=60
COMPANION_LLM_BASE_URL=https://api.openai.com/v1
COMPANION_LLM_API_KEY=
COMPANION_LLM_MODEL=
COMPANION_LLM_TIMEOUT_SECONDS=20
