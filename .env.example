# Copy to .env in the repository root. Never commit .env.
DATABASE_URL=sqlite:///./pathly.db
# PostgreSQL: pip install -e ".[postgres]" then set:
# DATABASE_URL=postgresql+psycopg://pathly:password@localhost:5432/pathly
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_HOURS=24

# Leave these empty for the explicitly labeled offline companion.
# OpenAI: https://api.openai.com/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Choose a model available in your provider account.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
